server {
  listen 443 ssl http2;
  include /etc/nginx/mime.types;
  server_name makebackground.io;
  proxy_pass_header Server;
  error_page 405 = $uri;
  client_max_body_size 20m;
  add_header X-Download-Options "noopen";
  add_header X-Content-Type-Options "nosniff";

  ssl on;
  ssl_certificate /etc/letsencrypt/live/makebackground.io/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/makebackground.io/privkey.pem;

  root /home/web/services/makebk/static/web/static/;

  location ~ ^/(d/.*)$ {
    root /home/web/services/makebk/static/web/static/;
    try_files $uri =404;
  }

  location ~ ^/(.*)$ {
    root /home/web/services/makebk/static/web/static/;
    try_files $1 $1/index.html =404;
  }
}

server {
  listen 80;
  server_name makebackground.io;
  add_header Strict-Transport-Security "max-age=16070400; includeSubDomains";
  rewrite     ^   https://$server_name$request_uri? permanent;
}
