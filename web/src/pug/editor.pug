//- module
#download.modal
  .card
    .card-body
      h4 Generated Image
      small.gray click the download button to download
      .result
        img
        video(controls)
    .card-footer
      a.btn.btn-lg.btn-outline-success.mr-2(href="#",download="") Download
      .btn.btn-lg.btn-outline-secondary(onclick="$('#download').modal('hide')") Close


include /module/palette-picker.pug
#editor-option-sample(style="display:none")
  #editor-option-sample-color.col-sm
    label Color
    +color-input('color')
  #editor-option-sample-number.col-sm
    label Number
    +slider
.editor.float
  .title
    big: b "No Name"
    span &nbsp;/&nbsp;
    span default background without name.
  .inner
    .row
      .col-sm-3.palette-option
        label Palette
        .palette(data-toggle="modal",data-target="#palette-picker")
          each i in ['#fb4','#fe9','#fdc','#9de']
            .color(style="background:" + i)
      .col-sm-2.speed-option
        label Speed
        +slider
      .col-sm-2.width-option
        label Width
        +slider
      .col-sm-2.height-option
        label Height
        +slider
      .col-sm-3
        label Download
        .btn-group.download
          .dropup
            .btn.btn-sm.btn-outline-dark.dropdown-toggle(href="#",data-toggle="dropdown") Static
            .dropdown-menu
              a.dropdown-item(data-type="static",data-format="png") PNG
              //-a.dropdown-item(data-type="static",data-format="jpeg") JPG
          .dropup
            .btn.btn-sm.btn-outline-dark.dropdown-toggle(href="#",data-toggle="dropdown") Live
            .dropdown-menu
              a.dropdown-item Chrome Only #[i.fa.fa-flask]
              .dropdown-divider
              a.dropdown-item(data-type="webm",data-dur="1",href="#") 1 sec
              a.dropdown-item(data-type="webm",data-dur="2",href="#") 2 sec
              a.dropdown-item(data-type="webm",data-dur="4",href="#") 4 sec
              a.dropdown-item(data-type="webm",data-dur="8",href="#") 8 sec
    #editor-custom-options.row
