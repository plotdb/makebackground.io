//- module

#info
  background: linear-gradient(315deg, rgb(227, 251, 253), rgb(245, 250, 250), rgb(255, 255, 255)) fixed
  background-size: cover
  border-top: 1px solid #ccc
  border-bottom: 1px solid #ccc
  padding: 80px 0 120px

#info > .inner
  font-size: 1.2em
  margin: auto
  width: 90%
  max-width: 1024px

@media (max-width: 480px)
  #info > .inner
    font-size: 15px

#subscribe
  background: unquote('url(data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSIxMCIgaGVpZ2h0PSIxMCIgdmlld0JveD0iMCAwIDEwIDEwIj48cGF0aCBkPSJNLTEwIC0xMEwyMCAyME0tMjAgLTEwTDEwIDIwTS0xMCAtMjBMMjAgMTAiIHN0cm9rZT0iI2ZhZmJmYyIgc3Ryb2tlLXdpZHRoPSIxIi8+PC9zdmc+)') #fdfffe
  box-shadow: 0 15px 20px rgba(0,0,0,.1)
  .btn
    position: relative
  .btn:after
    content: ""
    display: block
    position: absolute
    right: 22px
    top: 16px
    font: normal normal normal 24px/1 FontAwesome

+keyframes(rotate)
  0%
    transform: rotate(0)
  50%
    transform: rotate(180deg)
  100%
    transform: rotate(360deg)

#subscribe.loading
  .btn:after
    content: "\f110"
    animation(rotate 1s linear infinite)

#subscribe.done
  .btn:after
    content: "\f00c"

#subscribe.fail
  .btn:after
    content: "\f00d"
    color: #f00

.btn.btn-action
  /* fallback for old browsers */
  background: #1D976C
  /* Chrome 10-25, Safari 5.1-6 */
  background: -webkit-linear-gradient(to right, #93F9B9, #1D976C)
  /* W3C, IE 10+/ Edge, Firefox 16+, Chrome 26+, Opera 12+, Safari 7+ */
  background: linear-gradient(to right, #93F9B9, #1D976C)
  border: none
  color: #fff
  transition(background 0.5s ease-in-out)

.btn.btn-action:hover
  /* fallback for old browsers */
  background: #1D976C
  /* W3C, IE 10+/ Edge, Firefox 16+, Chrome 26+, Opera 12+, Safari 7+ */
  background: linear-gradient(to right, #4ea06d, #0a5037)
