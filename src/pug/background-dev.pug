//- module
extends /base.pug
block body
  #micro-nav
    a.title(href="/#gallery") #[i.fa.fa-chevron-left] MAKEBACKGROUND.IO
  #container
  include /editor.pug
  script(src="/js/bk/" + name + ".js")
  //-script(src="/backgrounds/" + name + "/main.js")
  script.
    var renderer = new ModRenderer("#container");
    var mod = null;
    ModManager.load("#{name}")
      .then(function(it) {
        mod = it;
        renderer.render(it);
      }).then(function() {
        initEditor(mod);
      });
