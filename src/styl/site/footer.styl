//- module
#footer
  background: linear-gradient(45deg, #010305, #323334)
  padding: 40px 10px
  color: #fff
  & > .row
    max-width: 1024px
    width: 90%
    margin: auto
  a
    color: #fff
    .fa
      vertical-align: middle
  a:hover
    color: #ffe

@media (max-width: 480px)
  #footer
    h1
      font-size: 1.75em
