
#landing
  top: 0
  left: 0
  width: 100%
  height: 100%
  text-align: center
  color: #444
  #hero-text
    width: 100%
    height: 100%
    position: absolute
    z-index: 4
    font-size: 20px
    padding: 180px 20px
    font-family: Abel
    .title
      font-size: 64px
      font-family: Abeezee
      text-shadow: -10px 10px 18px rgba(0,0,0,.3), 10px -10px 30px rgba(192,128,255,.1)
    h2
      font-size: 22px

#landing-demo
  position: absolute
  top: 0%
  left: 0%
  width: 100%
  height: 100%
  div
    width: 100%
    height: 100%
    position: absolute
    top: 0
    left: 0
    opacity: 0
    transition: none
    transition: opacity 1s ease-in-out
  div.show
    transition: opacity 1s ease-in-out
    opacity: 1
  div.fade
    transition: opacity 1s ease-in-out
    opacity: 0
  z-index: 1
  padding: 0
  margin: 0
  canvas
    background: #fff
    border-bottom: 1px solid #999
    width: 100%
    height: 100%

#quick-picker
  position: absolute
  z-index: 5
  bottom: 30px
  width: 100%
  .thumb
    display: inline-block
    width: 110px
    height: 110px
    margin: 5px 10px
    background-color: #000
    border-radius: 2px
    margin-bottom: 10px
    box-shadow: 0 8px 16px rgba(0,0,0,.6)
    background-position: center center
    background-size: cover

@media(max-width: 480px)
  #landing
    #quick-picker .thumb
      width: 52px
      height: 52px
      margin: 5px
    #hero-text
      .title
        font-size: 34px
        span
          display: none
      .desc
        font-size: 17px
