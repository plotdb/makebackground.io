//- module

#gallery
  .list
    text-align: center
    max-width: 1200px
    margin: auto
    .item
      display: inline-block
      .name
        font-size: 13px
        font-weight: light
        color: #444
        text-decoration: none
      .thumb
        cursor: pointer
        box-shadow: 0 2px 1px rgba(0,0,0,.3)
        border-radius: 3px
        width: 200px
        height: 200px
        margin: 50px 50px 5px 50px

#galleryx
  .list
    max-width: 961px
    margin: 30px auto
    background: #999
    padding: 0 0 1px 1px
    .item
      display: inline-block
      padding: 1px 1px 0 0
      text-align: center
      width: 240px
      height: 240px
      margin: 0 0 1px
      vertical-align: middle
      .name
        display: none
      .thumb
        width: 100%
        height: 240px
        border-radius: 0px
        //border: 1px solid transparent
        //box-shadow: 0 4px 8px rgba(0,0,0,.4)
        background-color: #f9fafb
        background-position: center center
        background-size: cover

