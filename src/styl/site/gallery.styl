//- module

#gallery
  background: linear-gradient(45deg, #eef, #fee)
  background-attachment: fixed
  padding-bottom: 60px
  .list
    text-align: center
    max-width: 1200px
    margin: auto
    .item
      display: inline-block
      text-decoration: none
      .name
        display: none
        font-size: 15px
        font-weight: light
        color: #444
        text-decoration: none
      .thumb
        cursor: pointer
        width: 200px
        height: 200px
        background-size: cover
        margin: 30px
        border: 6px solid #fff
        box-shadow: 0 8px 20px rgba(0,0,0,.2), inset 0 2px 4px rgba(0,0,0,.2)
        border-radius: 4px
        overflow: hidden
        img
          width: 100%

@media(max-width: 480px)
  #gallery
    .list .item .thumb
      width: 260px
      height: 260px
