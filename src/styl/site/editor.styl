//- module

.ldColorPicker
  width: 230px

.editor.float
  font-family: Abeezee
  font-size: 14px
  position: absolute
  bottom: 30px
  width: 1024px
  .title
    color: rgba(0,0,0,.7)
    //-text-shadow: -1px -1px 0px rgba(255,255,255,.2), 0px -1px 0px rgba(255,255,255,.2), 1px -1px 0px rgba(255,255,255,.2), -1px 0px 0px rgba(255,255,255,.2), 1px 0px 0px rgba(255,255,255,.2), -1px 1px 0px rgba(255,255,255,.2), 0px 1px 0px rgba(255,255,255,.2), -1px 1px 0px rgba(255,255,255,.2)
  & > .inner
    opacity: 0.8
    background: rgba(255,255,255,0.3)
    border: 1px solid rgba(0,0,0,.3)
    border-radius: 3px
    padding: 15px 15px
    transition: background 0.3s ease-in-out, opacity 0.3s ease-in-out
    &:hover
      opacity: 1
      background: rgba(255,255,255,1)
      border: 1px solid #ccc
      box-shadow: 0 2px 3px rgba(0,0,0,.2)
  left: 0
  right: 0
  margin: auto
  .row
    margin-bottom: 18px
  .row:last-of-type
    margin-bottom: 0

.editor .btn-group
  flexbox()
  .btn, .dropup
    flex(1 1 auto)
  .dropup a
    cursor: pointer
  .dropup .btn
    width: 100%
    border-radius: 0
    border-left-width: 0
  .dropup:first-child .btn
    border-radius: 3px 0 0 3px
    border-left-width: 1px
  .dropup:last-child .btn
    border-radius: 0 3px 3px 0

.editor
  .color
    position: relative
    .inner
      background: #f00
      width: 5px
      height: 21px
      position: absolute
      top: 5px
      right: 5px
      border-radius: 5px


#download.modal .card
  centered()
  width: 90%
  max-width: 640px
  height: 420px
  text-align: center
  .footer
    .btn
      position: relative
      z-index: 2
  .result
    background: center center no-repeat
    background-size: contain
    margin: 10px auto 0
    max-width: 400px
    height: 200px
    position: relative
    z-index: 1
    video, img
      margin: auto
      max-width: 100%
      max-height: 100%
      box-shadow: 0 2px 4px rgba(0,0,0,.3)
      border: 1px solid #ccc
      position: absolute
      left: -600px
      right: -600px
      top: -50px
      bottom: -50px

#micro-nav
  position: absolute
  top: 10px
  left: 10px
  z-index: 2
  .title
    cursor: pointer
    color: #222
    text-decoration: none
    padding: 5px 10px
    border-radius: 5px
    opacity: 0.8
    font-size: 18px
    transition: background ease-in-out 0.2s
    text-shadow: -1px -1px 1px rgba(255,255,255,.8), 0px -1px 1px rgba(255,255,255,.8), 1px -1px 1px rgba(255,255,255,.8), -1px 0px 1px rgba(255,255,255,.8), 1px 0px 1px rgba(255,255,255,.8), -1px 1px 1px rgba(255,255,255,.8), 0px 1px 1px rgba(255,255,255,.8), -1px 1px 1px rgba(255,255,255,.8)
    &:hover
      background: rgba(128,128,128,.2)

#canvas-container
  width: 100%
  height: 100%
  position: relative
  overflow: hidden
  background: unquote('url(data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABAAAAAQCAIAAACQkWg2AAAAGXRFWHRTb2Z0d2FyZQBBZG9iZSBJbWFnZVJlYWR5ccllPAAAAC1JREFUeNpi/PnzJwM2wMbGhlWciYFEMKqBGMD4//9/rBK/fv0aDSX6aQAIMAAQbgkHc5ovsQAAAABJRU5ErkJggg==)') center center #fff
  canvas
    position: absolute
    top: 0
    left: 0
    right: 0
    bottom: 0
    margin: auto
    z-index: 0

@media (max-width: 480px)
  .editor.float
    width: 90%
    .inner
      max-height: 260px
      overflow: scroll
    .row > div
      margin-bottom: 15px
    .color .inner
      height: 17px
    .title span
      font-size: 12px
    .title span:last-of-type
      display: block
      margin: -3px 5px 3px
