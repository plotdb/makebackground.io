//- module

.ldColorPicker
  width: 230px

.editor.float
  font-size: 14px
  position: absolute
  bottom: 30px
  width: 1024px
  .title
    color: rgba(0,0,0,.7)
    text-shadow: -1px -1px 0px rgba(255,255,255,.2), 0px -1px 0px rgba(255,255,255,.2), 1px -1px 0px rgba(255,255,255,.2), -1px 0px 0px rgba(255,255,255,.2), 1px 0px 0px rgba(255,255,255,.2), -1px 1px 0px rgba(255,255,255,.2), 0px 1px 0px rgba(255,255,255,.2), -1px 1px 0px rgba(255,255,255,.2)
  & > .inner
    background: rgba(255,255,255,0.85)
    border: 1px solid #ccc
    box-shadow: 0 2px 3px rgba(0,0,0,.2)
    border-radius: 3px
    padding: 15px 15px
  left: 0
  right: 0
  margin: auto
  .row
    margin-bottom: 18px
  .row:last-of-type
    margin-bottom: 0

.editor .btn-group
  flexbox()
  .btn
    flex(1 1 auto)
.editor
  .color
    position: relative
    .inner
      background: #f00
      width: 5px
      height: 21px
      position: absolute
      top: 5px
      right: 5px
      border-radius: 5px


#download.modal .card
  centered()
  width: 90%
  max-width: 640px
  height: 380px
  text-align: center
  .result
    background: center center no-repeat
    background-size: contain
    margin: auto
    min-height: 200px
    position: relative
    img
      border: 1px solid #ccc
      position: absolute
      left: -600px
      right: -600px
      top: -50px
      bottom: -50px
      margin: auto
      max-width: 100%
      max-height: 100%

#micro-nav
  position: absolute
  top: 10px
  left: 10px
  .title
    cursor: pointer
    color: #222
    text-decoration: none
    padding: 5px 10px
    border-radius: 5px
    opacity: 0.8
    font-size: 18px
    transition: background ease-in-out 0.2s
    text-shadow: -1px -1px 1px rgba(255,255,255,.8), 0px -1px 1px rgba(255,255,255,.8), 1px -1px 1px rgba(255,255,255,.8), -1px 0px 1px rgba(255,255,255,.8), 1px 0px 1px rgba(255,255,255,.8), -1px 1px 1px rgba(255,255,255,.8), 0px 1px 1px rgba(255,255,255,.8), -1px 1px 1px rgba(255,255,255,.8)
    &:hover
      background: rgba(128,128,128,.2)
