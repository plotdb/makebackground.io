@import 'vars.styl'
@import 'basic.styl'

@font-face
  font-family: Abel
  src: url(/assets/fonts/system/Abel-Regular.ttf)

@font-face
  font-family: Abeezee
  src: url(/assets/fonts/system/ABeeZee-Regular.ttf)

html,body
  width: 100%
  height: 100%
  margin: 0
  padding: 0
  font-family: Abel
  font-size: 16px
  line-height: 1.57em

h1, h2, h3, h4, h5, h6
  font-family: Abeezee
h1
  font-size: 2.2em

@media (max-width: 480px)
  html, body
    font-size: 14px

@import 'generic/index.styl'
@import 'modal/index.styl'
@import 'component/index.styl'
@import 'site/index.styl'
